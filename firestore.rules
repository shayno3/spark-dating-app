rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ─────────────────────────────────────────────────────────────
    // Anyone signed in can read profiles (needed for Discover/Nearby).
    // Only the owner can write their own profile.
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Likes ─────────────────────────────────────────────────────────────
    // sent/received sub-collections: owner reads+writes their own, target
    // can read their received (for "who liked me"), owner writes received
    // on the target's behalf when recording a like.
    match /likes/{uid}/sent/{targetUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /likes/{uid}/received/{fromUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // The person doing the liking writes to the target's received list
      allow write: if request.auth != null && request.auth.uid == fromUid;
    }

    // ── Matches ───────────────────────────────────────────────────────────
    // Both participants can read and write the match document.
    match /matches/{matchId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in resource.data.uids;
      // Allow create when the user's uid will be in the new doc's uids list
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.uids;
    }

    // ── Messages ──────────────────────────────────────────────────────────
    // C4: Only users who are participants in the parent match may read/write
    // messages. Uses a cross-document get() to check the matches/{matchId}.uids
    // list so an outsider who guesses a matchId cannot read private chats.
    match /messages/{matchId}/msgs/{msgId} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.uids;
    }

    // ── Glasses Pairing ───────────────────────────────────────────────────
    // glassPair documents are read by the glasses BEFORE the user is signed
    // in (the glasses enter the code first, then use the encrypted record to
    // authenticate). Single-document GET is allowed without auth so the glasses
    // can fetch by known code. LIST (enumeration/querying) is blocked so codes
    // cannot be scraped en-masse. Only authenticated users may create/delete.
    match /glassPair/{code} {
      allow get:    if true;                        // glasses fetch a specific code pre-auth
      allow list:   if false;                       // C3: block enumeration of all codes
      allow create: if request.auth != null;        // phone writes after PIN setup
      allow delete: if request.auth != null;        // phone can reset the code
    }

    // ── Reports ───────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read:   if false; // admin only (via Firebase console)
    }
  }
}
