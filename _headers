/*
  # Prevent the app from being embedded in iframes on other sites (clickjacking)
  X-Frame-Options: DENY

  # Prevent browsers from MIME-sniffing responses away from the declared content-type
  X-Content-Type-Options: nosniff

  # Only send the origin when crossing from HTTPS to HTTPS; strip it on HTTP
  Referrer-Policy: strict-origin-when-cross-origin

  # Allow camera/mic/geolocation (used by the app) but block payment/usb/etc.
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=()

  # Content Security Policy
  # script-src needs 'unsafe-inline' because all JS is inline in the single-file PWA.
  # style-src needs 'unsafe-inline' for the same reason.
  # connect-src is the most important — restricts which servers the app can talk to.
  # *.cloudfunctions.net and *.run.app are required for Firebase Cloud Functions v2 callable functions.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.google.com https://recaptcha.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://*.firebasestorage.app; media-src 'self' blob: https://firebasestorage.googleapis.com https://*.firebasestorage.app; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebasestorage.app wss://*.firebaseio.com https://www.google.com https://recaptcha.google.com https://*.cloudfunctions.net https://*.run.app; frame-src https://www.google.com https://recaptcha.google.com https://spark-dating-c74f4.firebaseapp.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';
