rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile photos — owner can write, anyone signed in can read
    match /photos/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024   // 5 MB max per file
                   && request.resource.contentType.matches('image/.*');
    }

    // Profile verification selfies
    match /verifications/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // H3: Voice notes — missing rule meant uploads were silently denied.
    // Owner can upload audio; any signed-in user can stream (to play in chat).
    match /voice/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
  }
}
